# Pinecone Index Configuration
# IMPORTANT: When creating your index in Pinecone, set:
#   - Dimension: 384 (sentence-transformers/all-MiniLM-L6-v2)
#   - Metric: cosine
PINECONE_INDEX_NAME=fin-analyst-index
